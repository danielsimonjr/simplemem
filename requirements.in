# transformers comes transitively (sentence-transformers / bert-score).
# Dependabot #43 (Trainer-class RCE, vuln <5.0.0rc3) is fixed by floor transformers>=5.0.0.
# This required bumping sentence-transformers 5.1.1 -> >=5.6.0 (which allows transformers<6.0.0
# instead of <5.0.0). bert-score 0.3.13 declares only transformers>=3.0.0 (no upper cap), so it
# doesn't block v5. Verified: sentence-transformers embedding + bert-score scoring both work
# under transformers 5.x (see the upgrade commit). 4.57.0 was yanked; the >=5 floor excludes it.
transformers>=5.0.0

# torch is transitive (sentence-transformers); floor past the patched advisories
# (2.9.1 medium, 2.10.0 low). The <=2.12.0 advisory (#64, torch.jit.script memory
# corruption) is now patched in 2.12.1 — bumped the floor from 2.10.0.
# 2026-08-02: a further advisory covers <=2.12.1, patched in 2.13.0.
torch>=2.13.0

